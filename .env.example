# Windows: xihe-jianmu-ipc Hub
IPC_HUB_BIND=0.0.0.0
IPC_PORT=3179
IPC_AUTH_TOKEN=replace-with-a-long-random-secret

# Windows: local Web/BFF
JIANMU_HTTP_URL=http://127.0.0.1:3179
JIANMU_HUB_URL=ws://127.0.0.1:3179
JIANMU_AUTH_TOKEN=replace-with-the-same-secret
BFF_HOST=127.0.0.1
# Web/BFF listen port (also used by Vite /api proxy in npm run dev)
BFF_PORT=8788
# Public path when reverse-proxied under a domain, e.g. /remote-oc/. Leave as / for direct :8788 access.
WEB_BASE=/
TASK_ACCEPT_TIMEOUT_MS=15000
TASK_IDLE_TIMEOUT_MS=120000
WEB_CONTROL_ID=web-control

# Mac: Remote Client
JIANMU_HTTP_URL=http://WINDOWS_LAN_IP:3179
JIANMU_HUB_URL=ws://WINDOWS_LAN_IP:3179
JIANMU_AUTH_TOKEN=replace-with-the-same-secret
REMOTE_CLIENT_ID=remote-oc-macbook
# Default adapter used when a task does not specify runtime.
AGENT_RUNTIME=openclaw
RUNTIME_HEALTH_INTERVAL_MS=15000
RUNTIME_CONNECT_TIMEOUT_MS=5000
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# Hermes Gateway API Server (enable API_SERVER_ENABLED in Hermes).
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace-with-the-hermes-api-server-key
# Optional Runs API model override. Leave blank to use the Hermes default.
HERMES_MODEL=
# Optional provider override for Hermes installations with multiple providers.
HERMES_PROVIDER=
# Initial model/provider startup can exceed 10 seconds; this only covers response headers.
HERMES_REQUEST_TIMEOUT_MS=60000
WEB_CONTROL_ID=web-control
JIANMU_PUBLIC_HTTP_URL=https://hub.example.com
JIANMU_PUBLIC_WS_URL=wss://hub.example.com
# HTTPS directory containing install.ps1, install.sh, release.json, and artifacts/.
REMOTE_OC_RELEASE_BASE_URL=https://downloads.example.com/remote-openclaw/0.1.0
# Public URL of the controller Web/BFF used in generated enrollment links.
# The hostname is also allowed to open the full control UI (chat, clients, tasks).
REMOTE_OC_CONTROL_URL=https://control.example.com
# Optional extra UI hostnames, comma-separated, if the public Host header differs.
REMOTE_OC_UI_HOSTS=
# Optional local state file for short-lived enrollment links. Set by start-public-stack.ps1 automatically.
REMOTE_OC_ENROLLMENT_STATE_PATH=
