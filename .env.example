# Windows: xihe-jianmu-ipc Hub
IPC_HUB_BIND=0.0.0.0
IPC_PORT=3179
IPC_AUTH_TOKEN=replace-with-a-long-random-secret

# Windows: local Web/BFF
JIANMU_HTTP_URL=http://127.0.0.1:3179
JIANMU_HUB_URL=ws://127.0.0.1:3179
JIANMU_AUTH_TOKEN=replace-with-the-same-secret
BFF_HOST=127.0.0.1
# Web/BFF listen port (also used by Vite /api proxy in npm run dev)
BFF_PORT=8788
WEB_CONTROL_ID=web-control

# Mac: Remote Client
JIANMU_HTTP_URL=http://WINDOWS_LAN_IP:3179
JIANMU_HUB_URL=ws://WINDOWS_LAN_IP:3179
JIANMU_AUTH_TOKEN=replace-with-the-same-secret
REMOTE_CLIENT_ID=remote-oc-macbook
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
WEB_CONTROL_ID=web-control
